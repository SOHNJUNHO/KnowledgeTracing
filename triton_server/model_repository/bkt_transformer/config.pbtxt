name: "bkt_transformer"
backend: "python"
max_batch_size: 0

input [
  {
    name: "obs"
    data_type: TYPE_FP32
    dims: [ -1, -1, 2 ]
  },
  {
    name: "output"
    data_type: TYPE_FP32
    dims: [ -1, -1, 2 ]
  }
]

output [
  {
    name: "corrects"
    data_type: TYPE_FP32
    dims: [ -1, 30, 1 ]
  },
  {
    name: "latents"
    data_type: TYPE_FP32
    dims: [ -1, 30, 138 ]
  },
  {
    name: "params"
    data_type: TYPE_FP32
    dims: [ -1, -1, 138, 4 ]
  }
]

instance_group [
  {
    count: 1
    kind: KIND_CPU
  }
]
