OPENAI_API_KEY=sk-...

LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

NEO4J_URI=neo4j+s://...
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=...

TOOLBOX_URL=http://localhost:5001

# Optional overrides
BKT_CHECKPOINT=   # absolute path to override the default checkpoint
N_SKILLS=138      # must match the checkpoint (icecream_8th: 137 skills + 1 padding)

# --- LLM backend ---
# Required. Choose: openai | vllm
LLM_BACKEND=openai

# Required. Model name passed to the completions API.
# openai backend: gpt-4o-mini
# vllm backend:   Qwen/Qwen2.5-7B-Instruct (or any model loaded by vLLM)
LLM_MODEL=gpt-4o-mini

# Required when LLM_BACKEND=vllm.
# Docker Compose: http://vllm-service:8080/v1
# Local dev:      http://localhost:8080/v1
VLLM_BASE_URL=http://localhost:8080/v1

# Model to load into the vLLM server container (used by docker-compose vllm profile)
VLLM_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct

# HuggingFace token for gated models (optional)
HF_TOKEN=

# --- Service URLs ---
# Override for local dev (defaults shown)
BKT_SERVICE_URL=http://localhost:8001
