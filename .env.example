LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

NEO4J_URI=neo4j+s://...
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=...

# --- LLM (Ollama, OpenAI-compatible) ---
# Point at any OpenAI-compatible endpoint.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3:8b

# Triton Inference Server gRPC endpoint (host:port)
TRITON_URL=triton:8001

# BKT_CHECKPOINT is read by the Triton container only (triton_server/.../model.py).
# FastAPI never reads it. To override the checkpoint path, set it under
# docker-compose.yml → services.triton.environment, not here.
# BKT_CHECKPOINT=
