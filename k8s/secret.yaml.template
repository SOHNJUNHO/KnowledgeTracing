# Copy this file to secret.yaml, fill in all REPLACE_ME values, then:
#   kubectl apply -f k8s/secret.yaml
#
# IMPORTANT: secret.yaml is in .gitignore — never commit it.
apiVersion: v1
kind: Secret
metadata:
  name: ai-tutor-secrets
  namespace: ai-tutor
type: Opaque
stringData:
  OPENAI_API_KEY: "REPLACE_ME"
  LANGFUSE_PUBLIC_KEY: "REPLACE_ME"
  LANGFUSE_SECRET_KEY: "REPLACE_ME"
  NEO4J_URI: "REPLACE_ME"
  NEO4J_USERNAME: "neo4j"
  NEO4J_PASSWORD: "REPLACE_ME"
  HF_TOKEN: "REPLACE_ME"
