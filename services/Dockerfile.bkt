FROM python:3.11-slim

WORKDIR /app

COPY requirements/bkt.txt requirements/bkt.txt
RUN pip install --no-cache-dir -r requirements/bkt.txt

# Install the ai_tutor package (for bkt.config and bkt.model)
COPY src/ ./src/
COPY setup.py pyproject.toml ./
RUN pip install --no-cache-dir -e . --no-deps

# Copy the service entrypoint
COPY services/bkt_service.py ./services/

ENV BKT_CHECKPOINT=/app/src/ai_tutor/bkt/checkpoints/upgraded-best-epoch=09-val_auc=0.7993.pt

EXPOSE 8001
CMD ["uvicorn", "bkt_service:app", "--app-dir", "/app/services", "--host", "0.0.0.0", "--port", "8001"]
