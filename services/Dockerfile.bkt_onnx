FROM python:3.11-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    onnxruntime \
    fastapi \
    "uvicorn[standard]" \
    pydantic \
    numpy \
    python-dotenv

COPY services/bkt_service_onnx.py ./services/
COPY model.onnx .

EXPOSE 8001
CMD ["uvicorn", "bkt_service_onnx:app", "--app-dir", "/app/services", \
     "--host", "0.0.0.0", "--port", "8001"]
